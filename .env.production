# Configurações de Produção
DEBUG=False
ALLOWED_HOSTS=seusite.railway.app,seusite.herokuapp.com,seusite.onrender.com

# Banco de dados (será configurado automaticamente pela plataforma)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis (será configurado automaticamente pela plataforma)
REDIS_URL=redis://host:port

# Email (configure com seu provedor)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app

# OpenAI (se usar chat IA)
OPENAI_API_KEY=sua-chave-openai

# Stripe (se usar pagamentos)
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Chave secreta (gere uma nova para produção)
SECRET_KEY=sua-chave-secreta-super-segura-aqui